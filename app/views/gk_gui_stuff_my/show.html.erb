<%# My account > Appearance: the settings that are optional in the instance, in the groups of Administration >
    Utseende, Like Redmine for me first. Each row says what it affects (Påverkar) under its description, as on
    Utseende, its key quiet by its name, and the same search as there above the groups. Each row saves at once by its rail, with the control that fits it: a switch, a
    segment (the person's choices of the value, with Av first where the setting has it), or the same table as under Administration with its own Spara. %>
<% gk_gui_stuff_form_page_assets %>
<h2><%= l(:label_gk_gui_stuff_my) %></h2>
<% reg = @register %>
<% if reg.nil? || (@rows.empty? && !reg.redmine_granted?) %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <%= gk_gui_stuff_direct_note %>
  <div class="gk-gui-stuff-form-page-top"><%= gk_gui_stuff_form_page_search %></div>
  <% user = User.current %>
  <% groups = @groups.dup %>
  <% groups.unshift(['instance', []]) if reg.redmine_granted? && groups.none? { |g, _| g == 'instance' } %>
  <% groups.each do |group, rows| %>
    <section class="gk-gui-stuff-form-page-my">
      <h3><%= l(:"label_gk_gui_stuff_group_#{group}") %></h3>
      <% if group == 'instance' && reg.redmine_granted? %>
        <%= gk_gui_stuff_rail(url: gk_gui_stuff_my_redmine_path, method: :post,
                              html: { class: 'gk-gui-stuff-form-page-my-row',
                                      data: { gk_gui_search: gk_gui_stuff_form_page_search_text(l(:label_gk_gui_stuff_redmine_for_me), l(:text_gk_gui_stuff_redmine_for_me), label_key: :label_gk_gui_stuff_redmine_for_me) } }) do %>
          <span class="gk-gui-stuff-form-page-my-name"><strong><%= l(:label_gk_gui_stuff_redmine_for_me) %></strong>
            <span class="gk-gui-stuff-form-page-help"><%= l(:text_gk_gui_stuff_redmine_for_me) %></span></span>
          <span class="gk-gui-stuff-form-page-my-control"><%= gk_gui_stuff_switch('on', reg.redmine_chosen?(user), label: l(:label_gk_gui_stuff_redmine_for_me)) %></span>
        <% end %>
      <% end %>
      <% rows.each do |row| %>
        <% choice = reg.person_choice(row.key, user) %>
        <% v = row.values.values.find(&:person) %>
        <% url = gk_gui_stuff_my_appearance_path(key: row.key) %>
        <% table = row.person == 'table' && v&.kind == 'table' %>
        <%= gk_gui_stuff_rail(url: url, method: :post, row: table,
                              html: { class: 'gk-gui-stuff-form-page-my-row', id: "my-#{row.key.tr('._', '--')}",
                                      data: { gk_gui_search: gk_gui_stuff_form_page_search_text(row.label, row.help, row.plugin_name, key: row.key, label_key: row.label_key) } }) do %>
          <span class="gk-gui-stuff-form-page-my-name"><strong><%= row.label %></strong>
            <%= gk_gui_stuff_form_page_key(row.key) %>
            <% if row.help.present? %><span class="gk-gui-stuff-form-page-help"><%= row.help %></span><% end %>
            <%= gk_gui_stuff_affects(reg, row.key) %>
            <span class="gk-gui-stuff-form-page-quiet"><%= l(table ? :text_gk_gui_stuff_optional_in_instance_own : :text_gk_gui_stuff_optional_in_instance) %></span></span>
          <% if table %>
            <span class="gk-gui-stuff-form-page-my-control gk-gui-stuff-form-page-my-table">
              <%= gk_gui_stuff_value_field(row, v, reg.person_value(row.key, v.name, user), scope: 'values') %>
              <%= gk_gui_stuff_row_save_button %></span>
          <% elsif v && %w[segment select].include?(row.person) %>
            <% list = v.choice_list.map { |c| c.is_a?(Array) ? c : [c, c] } %>
            <% selected = row.person_off && choice[:on] == false ? 'off' : reg.person_value(row.key, v.name, user).to_s %>
            <% off = row.person_off ? [[l(:label_gk_gui_stuff_col_off), 'off']] : [] %>
            <span class="gk-gui-stuff-form-page-my-control"><%= gk_gui_stuff_segment('choice', off + list.map { |t, val| [t, val.to_s] }, selected, label: row.label) %></span>
          <% else %>
            <span class="gk-gui-stuff-form-page-my-control"><%= gk_gui_stuff_switch('on', choice[:on].nil? ? choice.fetch(:default, true) : choice[:on], label: row.label) %></span>
          <% end %>
        <% end %>
      <% end %>
    </section>
  <% end %>
<% end %>
<p><%= link_to l(:button_back), my_account_path %></p>
<% html_title l(:label_gk_gui_stuff_my) %>
