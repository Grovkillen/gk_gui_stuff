<%# core's badges, the progress bar, the avatar and the line "Tillagd av" for a person in memory; each series
    draws its own (6.0 has no avatar without Gravatar). The progress bar is Bara grafiskt: core gives its parts a
    title (the per cent), a tooltip on hover in every series %>
<% u = demo[:users].first %>
<div class="gk-gui-stuff-sg-tiles">
  <%= gk_gui_stuff_sg_row(l(:label_gk_gui_stuff_sg_core_badges), "span.badge.badge-status-open, -closed, -locked, .badge-private") do %>
    <%= gk_gui_stuff_sg_badges(demo[:statuses][0].name, demo[:statuses][1].name) %>
  <% end %>
  <%= gk_gui_stuff_sg_row(l(:label_gk_gui_stuff_sg_core_progress), "progress_bar([30, 60], legend: '60%')", mode: :graphic) do %><%= progress_bar([30, 60], legend: '60%') %><% end %>
  <%= gk_gui_stuff_sg_row(l(:label_gk_gui_stuff_sg_core_avatars), "avatar(user), link_to_user(user), authoring(time, user)", mode: :graphic) do %>
    <%= avatar(u, size: 24) %> <%= link_to_user u %> <span class="gk-gui-stuff-direct-note"><%= authoring(Time.current - 2.days, u) %></span>
  <% end %>
</div>
