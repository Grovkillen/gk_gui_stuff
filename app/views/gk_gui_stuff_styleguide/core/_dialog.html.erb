<%# Redmine's dialog shown still, never with showModal. The three elements of jQuery UI's frame are the one
    copy of markup on the page (accepted as the exception); the content is core's own watchers/_new with
    an issue and people in memory, inert so that nothing in it can be sent, typed in or reached. GK does not use it.
    The close button is drawn as jQuery UI's dialog draws it (a button with the icon closethick and its word hidden),
    and the list has ten people, so that core's box of a fixed height is filled as in an installation in use. %>
<% @gk_gui_stuff_sg_mode = :still %>
<div class="gk-gui-stuff-sg-tiles">
  <%= gk_gui_stuff_sg_row(l(:label_gk_gui_stuff_sg_core_dialog), "render partial: 'watchers/new', locals: { watchables:, users: }") do %>
    <p class="gk-gui-stuff-direct-note"><%= l(:text_gk_gui_stuff_sg_dialog) %></p>
    <div class="ui-dialog ui-widget ui-widget-content ui-corner-all modal gk-gui-stuff-sg-still" role="dialog" aria-label="<%= l(:permission_add_issue_watchers) %>" inert>
      <div class="ui-dialog-titlebar ui-widget-header ui-helper-clearfix"><span class="ui-dialog-title"><%= l(:permission_add_issue_watchers) %></span>
        <button type="button" class="ui-button ui-corner-all ui-widget ui-button-icon-only ui-dialog-titlebar-close" title="<%= l(:gk_gui_stuff_close) %>"><span class="ui-button-icon ui-icon ui-icon-closethick"></span><span class="ui-button-icon-space"> </span><%= l(:gk_gui_stuff_close) %></button></div>
      <div class="ui-dialog-content ui-widget-content"><%= render partial: 'watchers/new', locals: { watchables: [demo[:issues].first], users: demo[:people] } %></div>
    </div>
  <% end %>
</div>
