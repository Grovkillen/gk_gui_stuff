<% @gk_gui_stuff_sg_mode = :server %>
<div class="gk-gui-stuff-sg-tiles">
  <%# the question first, the box's button with the action's name and Avbryt, and the reason under them %>
  <%= gk_gui_stuff_sg_row(l(:label_gk_gui_stuff_sg_reason), "gk_gui_stuff_fly(label) { … gk_gui_stuff_fly_buttons(label) }") do %>
    <%= gk_gui_stuff_fly(l(:label_gk_gui_stuff_sg_example_action)) do %>
      <%= form_tag(save) do %>
        <p><%= l(:text_gk_gui_stuff_sg_fly) %></p>
        <%= gk_gui_stuff_fly_buttons(l(:label_gk_gui_stuff_sg_example_action), keys: true) %>
        <%= gk_gui_stuff_reason_block(required: false, id: 'gk-gui-stuff-sg-reason', name: 'reason') %>
      <% end %>
    <% end %>
  <% end %>
  <%= gk_gui_stuff_sg_row(l(:label_gk_gui_stuff_sg_alarm), "role: :alarm, gk_gui_stuff_fly_buttons(…, alarm: true)") do %>
    <%= gk_gui_stuff_fly(l(:button_delete), role: :alarm) do %>
      <%= form_tag(save) do %>
        <p><%= l(:text_gk_gui_stuff_sg_cannot_undo) %></p>
        <%= gk_gui_stuff_fly_buttons(l(:button_delete), alarm: true) %>
      <% end %>
    <% end %>
  <% end %>
  <%# core's add icon alone opens the marks as pills to click, the note first %>
  <%= gk_gui_stuff_sg_row(l(:label_gk_gui_stuff_sg_icon_only), "gk_gui_stuff_fly(label, icon: 'add', icon_only: true) { … }") do %>
    <%= gk_gui_stuff_fly(l(:label_gk_gui_stuff_sg_mark), icon: 'add', icon_only: true) do %>
      <%= form_tag(save) do %>
        <p><%= text_field_tag 'note', '', placeholder: l(:text_gk_gui_stuff_sg_note_placeholder), 'aria-label': l(:text_gk_gui_stuff_sg_note_placeholder), id: nil, class: 'gk-gui-stuff-fly-field' %></p>
        <p class="gk-gui-stuff-pill-row"><%= gk_gui_stuff_pill(l(:label_gk_gui_stuff_sg_example_mark), role: 10, button: { type: 'submit', name: 'mark', value: 1 }, choice: true) %><%= gk_gui_stuff_pill(l(:label_gk_gui_stuff_sg_example_group), role: 7, button: { type: 'submit', name: 'mark', value: 2 }, choice: true) %></p>
        <p class="gk-gui-stuff-fly-hint"><%= l(:text_gk_gui_stuff_sg_one_click) %></p>
      <% end %>
    <% end %>
  <% end %>
  <%# a fly at a link a script drew (gk_gui_stuff_styleguide.js): the button copies the link and stands in its place %>
  <%= gk_gui_stuff_sg_row(l(:label_gk_gui_stuff_sg_script), "GkGui.fly.open(anchor, content, {role})", mode: :nosave) do %>
    <%= link_to sprite_icon('fav', l(:label_gk_gui_stuff_sg_open_layer)), '#', class: 'icon icon-fav',
                data: { gk_gui_sg_fly: { intro: l(:text_gk_gui_stuff_sg_fly_script), rows: [l(:label_gk_gui_stuff_sg_example_task), l(:label_gk_gui_stuff_sg_example_action)],
                                         button: l(:button_gk_gui_stuff_sg_replace), cancel: l(:button_cancel) }.to_json } %>
  <% end %>
  <%# the box's edge follows the button's role: grey without one, the button grey at rest %>
  <%= gk_gui_stuff_sg_row(l(:label_gk_gui_stuff_sg_no_role), "gk_gui_stuff_fly(label) { … }", mode: :nosave) do %>
    <%= gk_gui_stuff_fly(l(:label_gk_gui_stuff_sg_example_action)) do %><p><%= l(:text_gk_gui_stuff_sg_fly) %></p><div class="gk-gui-stuff-fly-buttons"><%= button_tag l(:button_cancel), type: 'button', data: { gk_gui_fly_cancel: '1' } %></div><% end %>
  <% end %>
  <%= gk_gui_stuff_sg_row(l(:label_gk_gui_stuff_sg_fly_roles), "role: 1, role: :admin", mode: :nosave) do %>
    <% [1, :admin].each do |r| %>
      <%= gk_gui_stuff_fly(l(:label_gk_gui_stuff_sg_example_action), role: r) do %><p><%= l(:text_gk_gui_stuff_sg_fly) %></p><div class="gk-gui-stuff-fly-buttons"><%= button_tag l(:button_cancel), type: 'button', data: { gk_gui_fly_cancel: '1' } %></div><% end %>
    <% end %>
  <% end %>
  <%# below 899 px every fold-out box is a sheet at the bottom; this box has no Avbryt of its own, so the script gives
      it one there %>
  <%= gk_gui_stuff_sg_row(l(:label_gk_gui_stuff_sg_sheet), '', mode: :nosave) do %>
    <span class="gk-gui-stuff-direct-note"><%= l(:text_gk_gui_stuff_sg_sheet) %></span>
    <%= gk_gui_stuff_fly(l(:label_gk_gui_stuff_sg_example_action)) do %><p><%= l(:text_gk_gui_stuff_sg_fly) %></p><% end %>
  <% end %>
  <%# the alarm button by specificity against core's submit button; form: names no form, so nothing is sent, and the
      tile is a picture only %>
  <%= gk_gui_stuff_sg_row(l(:label_gk_gui_stuff_sg_alarm_button), "button_tag(label, type: 'submit', class: 'gk-gui-stuff-btn-alarm')", mode: :still) do %>
    <%= button_tag l(:button_delete), type: 'submit', class: 'gk-gui-stuff-btn-alarm', form: 'gk-gui-stuff-sg-none' %> <%= button_tag l(:button_save), type: 'submit', form: 'gk-gui-stuff-sg-none' %>
  <% end %>
</div>
