<%# Visa for long notes: Redmine shows a note's whole text in the history; with the setting, the note folded at the
    height with Visa allt under it, as the fold leaves it (the style guide's fold). row: the setting %>
<% gk_gui_stuff_preview_stylesheet('gk_gui_stuff_modules') %>
<% long = content_tag(:p, l(:text_gk_gui_stuff_preview_long)) %>
<%= gk_gui_stuff_appearance_preview(row, off: content_tag(:div, content_tag(:div, long + long, class: 'wiki'), class: 'journal gk-gui-stuff-sg-still', inert: true),
                                         on: content_tag(:div, gk_gui_stuff_sg_fold(:div, long + long, html_class: 'wiki'), class: 'journal')) %>
