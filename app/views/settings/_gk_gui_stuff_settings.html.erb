<%# gk_gui_stuff: only what is not an appearance setting: Om pluginet, the grant of Like Redmine for me, the GK plugins'
    top menu words, the counters' cache time and the change log. The modules and every other appearance setting are on
    Administration > Utseende. Every change here is a records event. %>
<% plugin = Redmine::Plugin.find(:gk_gui_stuff) %>
<% sw = GkGuiStuff::Switches %>
<% changelog = ["CHANGELOG.#{current_language}.md", 'CHANGELOG.md'].map { |f| File.join(plugin.directory, f) }.find { |f| File.exist?(f) } %>
<fieldset class="box"><legend><%= l(:label_gk_gui_stuff_about) %></legend>
  <div><strong><%= plugin.name %></strong> <%= plugin.version %></div>
  <div><%= l(:text_gk_gui_stuff_description) %></div>
  <div><%= link_to l(:label_gk_gui_stuff_appearance), gk_gui_stuff_appearance_path %></div>
</fieldset>
<fieldset class="box tabular"><legend><%= l(:label_gk_gui_stuff_settings_own) %></legend>
  <p data-gk-gui-search="<%= gk_gui_stuff_form_page_search_text(key: 'user_core_like', label_key: :label_gk_gui_stuff_user_core_like) %>"><label for="gk_gui_stuff_user_core_like"><%= l(:label_gk_gui_stuff_user_core_like) %></label>
    <%= hidden_field_tag 'settings[user_core_like]', '0', id: nil %>
    <%= check_box_tag 'settings[user_core_like]', '1', sw.user_core_like_allowed?, id: 'gk_gui_stuff_user_core_like' %>
    <em class="info"><%= l(:text_gk_gui_stuff_user_core_like) %></em></p>
  <p data-gk-gui-search="<%= gk_gui_stuff_form_page_search_text(key: 'personal_count_seconds', label_key: :label_gk_gui_stuff_personal_count_seconds) %>"><label for="gk_gui_stuff_personal_count_seconds"><%= l(:label_gk_gui_stuff_personal_count_seconds) %></label>
    <%= number_field_tag 'settings[personal_count_seconds]', sw.int('personal_count_seconds', 60, 0), min: 0, max: 3600, step: 10, id: 'gk_gui_stuff_personal_count_seconds' %>
    <em class="info"><%= l(:text_gk_gui_stuff_personal_count_seconds) %></em></p>
</fieldset>
<%# The Meaning modes of GK's page types have their own page (Administration > Meningsvy och Klassisk vy); they are
    kept as they are, unseen, since core stores the plugin's settings as the form sends them %>
<% (sw.settings['meaning'].is_a?(Hash) ? sw.settings['meaning'] : {}).each do |key, row| %>
  <% (row.is_a?(Hash) ? row : {}).each do |name, value| %><%= hidden_field_tag "settings[meaning][#{key}][#{name}]", value, id: nil %><% end %>
<% end %>
<%# The GK plugins' entries in the top menu under the installation's own word (TopMenu); other languages on fields' Översättningar %>
<% tm_items = GkGuiStuff::TopMenu.items %>
<% if tm_items.any? %>
<fieldset class="box"><legend><%= l(:label_gk_gui_stuff_top_menu) %></legend>
  <p><em class="info"><%= l(:text_gk_gui_stuff_top_menu) %></em></p>
  <table class="list gk-gui-stuff-top-menu-settings">
    <thead><tr><th><%= l(:label_gk_gui_stuff_top_menu_entry) %></th><th><%= l(:label_gk_gui_stuff_top_menu_caption) %></th></tr></thead>
    <tbody>
    <% tm_items.each do |item| %>
      <% name = item.name.to_s %>
      <% own = GkGuiStuff::TopMenu.stored.dig(name, 'caption'); own = own.is_a?(Hash) ? own : {} %>
      <% word = GkGuiStuff::TopMenu.plugin_caption(item) %>
      <tr>
        <td class="name"><%= word %><br><span class="info"><%= name %></span></td>
        <td class="caption"><%= text_field_tag "settings[top_menu][#{name}][caption][#{current_language}]", own[current_language.to_s].to_s, size: 28, id: nil,
                               placeholder: word, 'aria-label': "#{word}: #{l(:label_gk_gui_stuff_top_menu_caption)}" %>
          <% own.except(current_language.to_s).each do |lang, text| %><%= hidden_field_tag "settings[top_menu][#{name}][caption][#{lang}]", text, id: nil %><% end %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
</fieldset>
<% end %>
<%# an entry that is not in the top menu right now (its plugin switched off) keeps what was stored for it, unseen %>
<% tm_names = tm_items.map { |i| i.name.to_s } %>
<% GkGuiStuff::TopMenu.stored.except(*tm_names).each do |name, row| %>
  <% (row.is_a?(Hash) && row['caption'].is_a?(Hash) ? row['caption'] : {}).each do |lang, text| %><%= hidden_field_tag "settings[top_menu][#{name}][caption][#{lang}]", text, id: nil %><% end %>
<% end %>
<% if changelog %>
<fieldset class="box"><legend><%= l(:label_gk_gui_stuff_changelog) %></legend>
  <% unless current_language.to_s.start_with?('en') %><div class="gk-changelog-note"><em><%= l(:text_gk_gui_stuff_changelog_english) %></em></div><% end %>
  <details class="gk-changelog"><summary><%= l(:button_show) %></summary>
  <div class="wiki"><%= Redmine::WikiFormatting.to_html('common_mark', File.read(changelog, encoding: 'UTF-8').sub(/\A.*?(?=^## )/m, '')).html_safe %></div>
  </details>
</fieldset>
<% end %>
