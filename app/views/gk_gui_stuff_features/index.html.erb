<%# Administration > Funktioner: one form for every function in gk_records' register in one table, the
    column headings once and a group per plugin under its fold button and count. Each function is a radio button
    under Av and På, the quiet "förval" under the default's, and under its name what it affects (Påverkar, from its
    footprint, no line when nothing is described). The fill link Allt av stands in core's div.contextual
    beside the heading; the bar at the bottom has the count, Ångra alla and Spara with the reason of the place
    gui_stuff.feature_switch (while that place is off, the same box with the changes and no field for a reason, as on
    Utseende). %>
<% gk_gui_stuff_form_page_assets %>
<% form_id = 'gk-gui-stuff-features-form' %>
<% if @register && @groups.present? %>
  <%= gk_gui_stuff_form_page_fill_links(form_id, [[l(:button_gk_gui_stuff_fill_all_off), 'all_off', 'reload', l(:text_gk_gui_stuff_fill_off_tip)]]) %>
<% end %>
<% content_for :header_tags do %><%= stylesheet_link_tag 'gk_gui_stuff_features', plugin: 'gk_gui_stuff' %><% end %>
<h2><%= l(:label_gk_gui_stuff_features) %></h2>
<p class="info"><%= l(:text_gk_gui_stuff_features) %></p>
<p class="gk-gui-stuff-form-page-links"><%= link_to l(:label_gk_gui_stuff_appearance), gk_gui_stuff_appearance_path %><% if GkGuiStuff.styleguide? %> · <%= link_to l(:label_gk_gui_stuff_styleguide), gk_gui_stuff_styleguide_path, GkGuiStuff::Effect.attributes('styleguide') %><% end %></p>
<% if @register.nil? %>
  <p class="nodata"><%= l(:text_gk_gui_stuff_features_no_register) %></p>
<% elsif @groups.blank? %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% else %>
  <% words = { '0' => l(:label_gk_gui_stuff_col_off), '1' => l(:label_gk_gui_stuff_col_on) } %>
  <% fills = { 'all_off' => @register.declared.keys.to_h { |k| ["features[#{k}]", '0'] } } %>
  <% names = @register.declared.transform_values(&:label) %>
  <%= form_tag gk_gui_stuff_features_path, method: :patch, id: form_id, class: 'gk-gui-stuff-form-page',
               autocomplete: 'off', data: gk_gui_stuff_form_page_data(fills: fills, words: { modes: words }) do %>
    <%= gk_gui_stuff_form_page_top %>
    <%# In core's div.autoscroll: a table wider than the window scrolls instead of squeezing its columns %>
    <div class="autoscroll gk-gui-stuff-form-page-scroll">
    <table class="list gk-gui-stuff-form-page-table gk-gui-stuff-features">
      <colgroup><col class="name"><col class="choice"><col class="choice"></colgroup>
      <thead><tr><th><%= l(:label_gk_gui_stuff_feature) %></th>
        <th class="gk-gui-stuff-choice-col"><%= words['0'] %></th><th class="gk-gui-stuff-choice-col"><%= words['1'] %></th></tr></thead>
      <% @groups.each_with_index do |(_plugin, features), i| %>
        <% list = features.sort_by(&:label) %>
        <%= gk_gui_stuff_form_page_group_head(list.first.plugin_name, l(:text_gk_gui_stuff_group_on, on: list.count { |f| @register.on?(f.key) }, count: list.size),
                                              "gk-gui-stuff-form-page-group-#{i}", 3) %>
        <tbody id="gk-gui-stuff-form-page-group-<%= i %>" class="gk-gui-stuff-form-page-group-body">
          <% list.each do |f| %>
            <% on = @register.on?(f.key) %>
            <% last = @last[f.key] %>
            <%= content_tag(:tr, id: gk_gui_stuff_form_page_anchor(f.key), class: 'gk-gui-stuff-form-page-row',
                                 data: { gk_gui_row: f.key, gk_gui_requires: Array(f.requires).join(' ').presence,
                                         gk_gui_search: gk_gui_stuff_form_page_search_text(f.label, f.help, f.plugin_name, key: f.key, label_key: f.label_key) }) do %>
              <td class="name">
                <span class="gk-gui-stuff-form-page-name"><%= f.label %></span>
                <%= gk_gui_stuff_form_page_key(f.key) %>
                <span class="gk-gui-stuff-form-page-was" hidden></span>
                <% if f.help.present? %><span class="gk-gui-stuff-form-page-help"><%= f.help %></span><% end %>
                <% related = Array(f.related).select { |k| names.key?(k) } %>
                <% if related.any? %>
                  <span class="gk-gui-stuff-form-page-related"><%= l(:label_gk_gui_stuff_related) %>
                    <%= safe_join(related.map { |k| link_to(names[k], "##{gk_gui_stuff_form_page_anchor(k)}") }, ', ') %></span>
                <% end %>
                <%= gk_gui_stuff_affects(@register, f.key) %>
                <% if last %>
                  <%= gk_gui_stuff_form_page_last(last[:enabled] ? words['1'] : words['0'], last,
                                                  gk_gui_stuff_form_page_history(GkRecords::Features::TARGET, last[:event]&.target_id)) %>
                <% end %>
              </td>
              <% [false, true].each do |state| %>
                <% word = words[state ? '1' : '0'] %>
                <% mark = f.default == state ? gk_gui_stuff_form_page_default_mark : nil %>
                <%= gk_gui_stuff_form_page_radio("features[#{f.key}]", state ? '1' : '0', on == state, label: "#{f.label}: #{word}", word: word, extra: mark) %>
              <% end %>
            <% end %>
          <% end %>
        </tbody>
      <% end %>
    </table>
    </div>
    <%= gk_gui_stuff_form_page_bar(GkGuiStuffFeaturesController::PLACE) %>
  <% end %>
<% end %>
<% html_title l(:label_gk_gui_stuff_features) %>
